# Same Supabase Session pooler string used by the data pipeline
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Long random string used to sign prototype sign-in cookies (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
# Public site URL, used in invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
