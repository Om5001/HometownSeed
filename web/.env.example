# Same Supabase Session pooler string used by the data pipeline (required)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Public site address, used in email links. Required in production (e.g. https://hometownseed.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Email (verification + password reset) through resend.com. Leave empty in development:
# links are then printed in the terminal and shown on screen.
RESEND_API_KEY=
EMAIL_FROM=Hometown Seed <hello@yourdomain.com>

# Optional pepper: a long random secret mixed into every password hash and kept OUT of the
# database (openssl rand -hex 32). Set it once before real users sign up and never change it.
AUTH_PEPPER=
